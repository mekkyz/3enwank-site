# /etc/enwank-site/env: read by enwank-site.service and by scripts/deploy.sh at build time.
# scripts/box-setup.sh creates the file with these defaults; edit, then `systemctl restart enwank-site`.
NODE_ENV=production
# The store's public catalogue over loopback (no TLS, no basic auth, no nginx cache in between).
CATALOGUE_URL=http://127.0.0.1:3000/account/api/public/catalogue
# Where the store is served, including its path. Used for Log in links when the catalogue carries none.
STORE_URL=https://3enwank.com/account
# Canonical origin for sitemap, hreflang and OpenGraph URLs.
SITE_URL=https://3enwank.com
# International format without "+", e.g. 201000000000. Empty hides WhatsApp everywhere.
WHATSAPP_NUMBER=
# 1 renders the chat widget and domain name ideas while the store still reports the assistant off.
ASSISTANT_PREVIEW=
# The platform's status feed over loopback (docs/design/status-page.md in the platform repo).
STATUS_FEED_URL=http://127.0.0.1:3000/account/api/public/status
# The public status page. Leave empty until status.3enwank.com has DNS and a certificate: empty hides every Status link.
STATUS_URL=
# Token behind POST /api/revalidate. The platform's Publish website hook is
# https://<site>/api/revalidate/?token=<this value>. box-setup.sh generates it.
SITE_REVALIDATE_SECRET=
