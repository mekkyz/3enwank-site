# Where the catalogue comes from at build time. On failure the checked-in catalogue.fallback.json is used.
CATALOGUE_URL=https://my.3enwank.com/api/public/catalogue
# Set to "fallback" to skip the network and build from catalogue.fallback.json (offline development, CI).
# CATALOGUE_SOURCE=fallback
# Optional "user:password" for a staging endpoint behind basic auth.
# CATALOGUE_AUTH=
# The store every Order / Log in link points at. The catalogue's own store links win when present.
STORE_URL=https://my.3enwank.com
# Canonical origin of this site, for sitemap, hreflang and OpenGraph URLs.
SITE_URL=https://3enwank.com
# WhatsApp number in international format without "+" (e.g. 201000000000). Empty hides the WhatsApp link.
WHATSAPP_NUMBER=
